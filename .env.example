# AI Resume Builder - Environment Variables Template
# Make a copy of this file, rename it to .env, and fill in the values.

# -----------------
# Server Variables
# -----------------
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resume-builder
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenAI API (For AI Assistant)
OPENAI_API_KEY=sk-your-openai-api-key

# -----------------
# Client Variables (must start with VITE_)
# -----------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_ENV=development
